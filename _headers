# Cloudflare Pages — header rules for the acg-cdn project.
#
# The /geo function MUST NOT be edge-cached. The response is per-visitor
# (based on IP-derived MaxMind geo), and any shared caching means every
# visitor sees the first-cached visitor's coords. Observed in prod
# 2026-05-20: /geo returned Westminster, CO to every caller globally,
# which made dallas-ga (the westernmost clinic) the universal "nearest"
# pairing for every Atlanta visitor.
#
# The function itself sets `Cache-Control: no-store` but Pages edge caching
# can ignore that under some configs. This `_headers` rule is the belt to
# the function's suspenders.

/geo
  Cache-Control: private, no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  CDN-Cache-Control: no-store

# Lib bundle has a fixed URL (acg-personalization-v1.js) — the `v1` suffix is a
# major-version pin, not per-release versioning. CF Pages defaults to
# `Cache-Control: public, max-age=16070400, must-revalidate` (186 days), which
# locks every browser onto whatever build it first downloaded — fresh deploys
# don't reach real visitors for months. Override to 5 min so a deploy
# propagates fast while still giving CF reasonable edge-cache efficiency for
# the bulk of requests.
/acg-personalization-v1.js
  Cache-Control: public, max-age=300, must-revalidate

# Same 5-min cap on MH exit popup — fresh deploys propagate to real visitors fast.
/mh-exit-popup-v1.js
  Cache-Control: public, max-age=300, must-revalidate
